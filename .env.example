# Copy this file to ".env" and fill in your own values.

# Port the server listens on (most hosting platforms set this automatically)
PORT=3000

# A secret key YOU make up — used to protect your dashboard and API.
# Put the SAME value in the extension's Settings page ("History API Key")
# and use it to log into the dashboard.
API_KEY=change_this_to_a_long_random_secret

# Optional: custom path for the data file
# DB_PATH=./data.json
